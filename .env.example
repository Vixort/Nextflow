# MariaDB (primary database) — local defaults match scripts/init-mariadb.sh
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nextflow

# JWT signing secret — REQUIRED outside local dev (min 32 chars); dev falls back to a hardcoded key
JWT_SECRET=change-me-to-a-long-random-string-32-chars-min

# Google Gemini API Key for Template AI Chat (optional — disables AI features if absent)
GEMINI_API_KEY=your-gemini-api-key-here

# Resend (contact form email delivery) — optional; without it submissions are still stored in the DB
RESEND_API_KEY=re_your-resend-api-key

# Inbox that receives contact form inquiries (must be the email used to sign up for Resend when using onboarding@resend.dev)
CONTACT_RECIPIENT_EMAIL=your@gmail.com